<Application x:Class="PetPlayer.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:helpers="clr-namespace:PetPlayer.Helpers">
    <Application.Resources>
        <ResourceDictionary>

            <helpers:SliderFillRatioConverter x:Key="SliderFillRatioConverter" />

            <!-- Palette -->
            <SolidColorBrush x:Key="AppBackgroundBrush" Color="#0A0A0C" />
            <SolidColorBrush x:Key="SurfaceBrush" Color="#15151A" />
            <SolidColorBrush x:Key="OverlaySurfaceBrush" Color="#CC141418" />
            <SolidColorBrush x:Key="ChromeBackgroundBrush" Color="#2B2B2B" />
            <SolidColorBrush x:Key="OverlaySurfaceLightBrush" Color="#B31C1C22" />
            <SolidColorBrush x:Key="BorderBrush" Color="#26FFFFFF" />
            <SolidColorBrush x:Key="AccentBrush" Color="#5AAAFF" />
            <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F2F2F5" />
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="#A6A6AD" />
            <SolidColorBrush x:Key="HoverBrush" Color="#22FFFFFF" />
            <!-- Darker, softer tone for icon glyphs (play/pause, mute, fullscreen, window chrome, etc.) instead of stark white. -->
            <SolidColorBrush x:Key="IconGlyphBrush" Color="#9AA0A6" />

            <!--
                Small translucent icon/text button used across the control bar and menus.
                Targets ButtonBase (not Button) so it also applies to the transcript-panel
                ToggleButton - WPF requires a Style's TargetType to match the element it's
                applied to, and ToggleButton is a ButtonBase sibling of Button, not a Button.
            -->
            <Style x:Key="IconButtonStyle" TargetType="ButtonBase">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{StaticResource IconGlyphBrush}" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="8,4" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <!-- Segoe MDL2 glyph icons look sharp/jagged under ClearType (tuned for
                     text on a light background, not small symbols over dark video) -
                     grayscale anti-aliasing renders them noticeably smoother. -->
                <Setter Property="TextOptions.TextRenderingMode" Value="Grayscale" />
                <Setter Property="TextOptions.TextHintingMode" Value="Fixed" />
                <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ButtonBase">
                            <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Root" Property="Background" Value="{StaticResource HoverBrush}" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.4" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Title-bar-style button (minimize/close) -->
            <Style x:Key="ChromeButtonStyle" TargetType="Button" BasedOn="{StaticResource IconButtonStyle}">
                <Setter Property="Width" Value="34" />
                <Setter Property="Height" Value="28" />
                <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
                <Setter Property="FontSize" Value="10" />
            </Style>

            <!-- Transparent hit-target for the slider track's decrease/increase regions - the
                 rounded rail + fill + thumb below do all the visible drawing. -->
            <Style x:Key="SliderRepeatButtonInvisible" TargetType="RepeatButton">
                <Setter Property="Focusable" Value="False" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RepeatButton">
                            <Rectangle Fill="Transparent" />
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!--
                Smooth, rounded slider: a thin pill-shaped rail with a colored fill up to
                the current value and a small circular thumb, replacing the OS's default
                (visually blocky) Slider chrome. Shared by the seek bar and volume slider.
            -->
            <Style x:Key="ControlBarSliderStyle" TargetType="Slider">
                <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                <Setter Property="Background" Value="#33FFFFFF" />
                <Setter Property="Height" Value="18" />
                <Setter Property="IsMoveToPointEnabled" Value="True" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Slider">
                            <Grid VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition>
                                        <ColumnDefinition.Width>
                                            <MultiBinding Converter="{StaticResource SliderFillRatioConverter}">
                                                <Binding Path="Value" RelativeSource="{RelativeSource TemplatedParent}" />
                                                <Binding Path="Minimum" RelativeSource="{RelativeSource TemplatedParent}" />
                                                <Binding Path="Maximum" RelativeSource="{RelativeSource TemplatedParent}" />
                                            </MultiBinding>
                                        </ColumnDefinition.Width>
                                    </ColumnDefinition>
                                    <ColumnDefinition>
                                        <ColumnDefinition.Width>
                                            <MultiBinding Converter="{StaticResource SliderFillRatioConverter}" ConverterParameter="Invert">
                                                <Binding Path="Value" RelativeSource="{RelativeSource TemplatedParent}" />
                                                <Binding Path="Minimum" RelativeSource="{RelativeSource TemplatedParent}" />
                                                <Binding Path="Maximum" RelativeSource="{RelativeSource TemplatedParent}" />
                                            </MultiBinding>
                                        </ColumnDefinition.Width>
                                    </ColumnDefinition>
                                </Grid.ColumnDefinitions>

                                <Border Grid.ColumnSpan="2" Height="4" CornerRadius="2" Background="{TemplateBinding Background}" />
                                <Border Grid.Column="0" Height="4" CornerRadius="2" Background="{TemplateBinding Foreground}" />

                                <Track x:Name="PART_Track" Grid.ColumnSpan="2">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Style="{StaticResource SliderRepeatButtonInvisible}" Command="Slider.DecreaseLarge" />
                                    </Track.DecreaseRepeatButton>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Style="{StaticResource SliderRepeatButtonInvisible}" Command="Slider.IncreaseLarge" />
                                    </Track.IncreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb x:Name="SliderThumb" Width="12" Height="12" Focusable="False">
                                            <Thumb.Template>
                                                <ControlTemplate TargetType="Thumb">
                                                    <Ellipse Fill="{StaticResource AccentBrush}" Width="12" Height="12" />
                                                </ControlTemplate>
                                            </Thumb.Template>
                                        </Thumb>
                                    </Track.Thumb>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!--
                MenuItem/ContextMenu/Separator deliberately left unstyled (no dark-theme
                override) so the right-click menu renders with the OS's native chrome -
                light background, blue hover highlight, checkmarks, submenu arrows -
                matching the plain Windows context-menu look (e.g. PotPlayer's).
            -->

            <Style TargetType="ToolTip">
                <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                <Setter Property="Padding" Value="6,3" />
            </Style>

        </ResourceDictionary>
    </Application.Resources>
</Application>
