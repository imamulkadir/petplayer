<Window x:Class="PetPlayer.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Pet Player Settings"
        Icon="pack://application:,,,/Resources/PetPlayer.ico"
        Width="640" Height="520"
        Background="{StaticResource AppBackgroundBrush}"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="0" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="SectionHeadingStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,14" />
        </Style>

        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>

        <Style x:Key="SettingsTabItemStyle" TargetType="TabItem">
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="4" Margin="0,0,6,2">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource HoverBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource HoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingsTabControlStyle" TargetType="TabControl">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!--
                                A StackPanel, not the default TabPanel: TabPanel has a
                                well-known quirk with TabStripPlacement="Left"/"Right" where
                                changing the selected tab visibly reorders the OTHER tabs
                                around it instead of just highlighting the selected one.
                                StackPanel lays items out in simple, stable declaration order.
                            -->
                            <StackPanel Grid.Column="0" Orientation="Vertical" IsItemsHost="True" Background="Transparent" />
                            <Border Grid.Column="1" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,0,0,0" />
                            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" Margin="18,0,0,0">
                                <ContentPresenter ContentSource="SelectedContent" />
                            </ScrollViewer>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Height="36" Background="{StaticResource SurfaceBrush}" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                    <Image Source="pack://application:,,,/Resources/PetPlayer.ico" Width="16" Height="16" VerticalAlignment="Center" />
                    <TextBlock Text="Pet Player Settings" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12"
                               VerticalAlignment="Center" Margin="8,0,0,0" />
                </StackPanel>

                <Button Grid.Column="2" Content="&#xE8BB;" Style="{StaticResource ChromeButtonStyle}"
                        Click="CloseButton_Click" Focusable="False" ToolTip="Close" />
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TabControl Grid.Row="0" Style="{StaticResource SettingsTabControlStyle}">

            <TabItem Header="General" Style="{StaticResource SettingsTabItemStyle}">
                <StackPanel>
                    <TextBlock Text="General" Style="{StaticResource SectionHeadingStyle}" />

                    <TextBlock Text="Autoplay" Style="{StaticResource FieldLabelStyle}" />
                    <CheckBox Content="Play videos automatically" IsChecked="{Binding Autoplay}" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,16" />

                    <TextBlock Text="Resume playback" Style="{StaticResource FieldLabelStyle}" />
                    <CheckBox Content="Remember last position" IsChecked="{Binding ResumePlaybackEnabled}" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,16" />

                    <TextBlock Text="Seek interval" Style="{StaticResource FieldLabelStyle}" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <TextBox Width="60" Text="{Binding SeekIntervalSeconds, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="seconds" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="8,0,0,0" />
                    </StackPanel>

                    <TextBlock Text="Volume step" Style="{StaticResource FieldLabelStyle}" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <TextBox Width="60" Text="{Binding VolumeStepPercent, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="%" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="8,0,0,0" />
                    </StackPanel>

                    <TextBlock Text="Controls hide after" Style="{StaticResource FieldLabelStyle}" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <TextBox Width="60" Text="{Binding ControlsHideDelaySeconds, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="seconds" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="8,0,0,0" />
                    </StackPanel>
                </StackPanel>
            </TabItem>

            <TabItem Header="Playback" Style="{StaticResource SettingsTabItemStyle}">
                <StackPanel>
                    <TextBlock Text="Playback" Style="{StaticResource SectionHeadingStyle}" />
                    <CheckBox Content="Automatically load matching subtitle files" IsChecked="{Binding AutoLoadMatchingSubtitle}" Foreground="{StaticResource TextPrimaryBrush}" />
                </StackPanel>
            </TabItem>

            <TabItem Header="Subtitles" Style="{StaticResource SettingsTabItemStyle}">
                <StackPanel>
                    <TextBlock Text="Subtitles" Style="{StaticResource SectionHeadingStyle}" />
                    <TextBlock Text="Applied the next time you start Pet Player." Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,-8,0,14" />

                    <TextBlock Text="Font size" Style="{StaticResource FieldLabelStyle}" />
                    <Slider Minimum="10" Maximum="60" Value="{Binding SubtitleFontSize}" Margin="0,0,0,16" />

                    <TextBlock Text="Vertical position" Style="{StaticResource FieldLabelStyle}" />
                    <Slider Minimum="0" Maximum="1" Value="{Binding SubtitleVerticalPosition}" Margin="0,0,0,16" />

                    <TextBlock Text="Text opacity" Style="{StaticResource FieldLabelStyle}" />
                    <Slider Minimum="0" Maximum="1" Value="{Binding SubtitleTextOpacity}" Margin="0,0,0,16" />

                    <CheckBox Content="Outline / shadow" IsChecked="{Binding SubtitleOutlineEnabled}" Foreground="{StaticResource TextPrimaryBrush}" />
                </StackPanel>
            </TabItem>

            <TabItem Header="Transcript" Style="{StaticResource SettingsTabItemStyle}">
                <StackPanel>
                    <TextBlock Text="Transcript" Style="{StaticResource SectionHeadingStyle}" />
                    <CheckBox Content="Show transcript panel by default" IsChecked="{Binding ShowTranscriptByDefault}" Foreground="{StaticResource TextPrimaryBrush}" />
                </StackPanel>
            </TabItem>

            <TabItem Header="Windows" Style="{StaticResource SettingsTabItemStyle}">
                <StackPanel>
                    <TextBlock Text="Windows" Style="{StaticResource SectionHeadingStyle}" />
                    <TextBlock Text="Makes Pet Player available under Explorer's Right-click → Open with. Only writes to your user registry hive - no admin rights needed."
                               Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,10" />

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Content="Register Pet Player in &quot;Open with&quot;" Padding="10,6" Margin="0,0,8,0"
                                Command="{Binding RegisterOpenWithCommand}" />
                        <Button Content="Remove from &quot;Open with&quot;" Padding="10,6"
                                Command="{Binding UnregisterOpenWithCommand}" />
                    </StackPanel>

                    <TextBlock Text="{Binding IsRegisteredForOpenWith, StringFormat='Currently registered: {0}'}"
                               Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,4" />
                    <TextBlock Text="{Binding IntegrationStatusMessage}" Foreground="{StaticResource AccentBrush}"
                               FontSize="12" TextWrapping="Wrap" />
                </StackPanel>
            </TabItem>

            <TabItem Header="Shortcuts" Style="{StaticResource SettingsTabItemStyle}">
                <StackPanel>
                    <StackPanel.Resources>
                        <Style x:Key="ShortcutRowStyle" TargetType="Grid">
                            <Setter Property="Margin" Value="0,0,0,7" />
                        </Style>
                        <Style x:Key="ShortcutKeyStyle" TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                            <Setter Property="FontFamily" Value="Consolas" />
                            <Setter Property="FontSize" Value="12" />
                            <Setter Property="VerticalAlignment" Value="Center" />
                        </Style>
                        <Style x:Key="ShortcutDescStyle" TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                            <Setter Property="FontSize" Value="12" />
                            <Setter Property="VerticalAlignment" Value="Center" />
                            <Setter Property="TextWrapping" Value="Wrap" />
                        </Style>
                    </StackPanel.Resources>

                    <TextBlock Text="Keyboard &amp; Mouse Shortcuts" Style="{StaticResource SectionHeadingStyle}" />
                    <TextBlock Text="Work anywhere in the window - clicking a button or dragging the seek bar first doesn't disable them."
                               Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,-8,0,14" TextWrapping="Wrap" />

                    <Grid Style="{StaticResource ShortcutRowStyle}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="180" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Space" Style="{StaticResource ShortcutKeyStyle}" />
                        <TextBlock Grid.Column="1" Text="Play / Pause" Style="{StaticResource ShortcutDescStyle}" />
                    </Grid>
                    <Grid Style="{StaticResource ShortcutRowStyle}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="180" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="← / →" Style="{StaticResource ShortcutKeyStyle}" />
                        <TextBlock Grid.Column="1" Text="Seek backward / forward (default 5s)" Style="{StaticResource ShortcutDescStyle}" />
                    </Grid>
                    <Grid Style="{StaticResource ShortcutRowStyle}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="180" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Shift + ← / →" Style="{StaticResource ShortcutKeyStyle}" />
                        <TextBlock Grid.Column="1" Text="Seek by 1 second" Style="{StaticResource ShortcutDescStyle}" />
                    </Grid>
                    <Grid Style="{StaticResource ShortcutRowStyle}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="180" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Ctrl + ← / →" Style="{StaticResource ShortcutKeyStyle}" />
                        <TextBlock Grid.Column="1" Text="Seek by 0.25 seconds" Style="{StaticResource ShortcutDescStyle}" />
                    </Grid>
                    <Grid Style="{StaticResource ShortcutRowStyle}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="180" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="J / L" Style="{StaticResource ShortcutKeyStyle}" />
                        <TextBlock Grid.Column="1" Text="Seek 10 seconds backward / forward" Style="{StaticResource ShortcutDescStyle}" />
                    </Grid>
                    <Grid Style="{StaticResource ShortcutRowStyle}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="180" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="↑ / ↓" Style="{StaticResource ShortcutKeyStyle}" />
                        <TextBlock Grid.Column="1" Text="Volume up / down (default step 5%)" Style="{StaticResource ShortcutDescStyle}" />
                    </Grid>
                    <Grid Style="{StaticResource ShortcutRowStyle}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="180" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Mouse scroll wheel" Style="{StaticResource ShortcutKeyStyle}" />
                        <TextBlock Grid.Column="1" Text="Volume up / down (anywhere over the video)" Style="{StaticResource ShortcutDescStyle}" />
                    </Grid>
                    <Grid Style="{StaticResource ShortcutRowStyle}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="180" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="M" Style="{StaticResource ShortcutKeyStyle}" />
                        <TextBlock Grid.Column="1" Text="Mute / unmute" Style="{StaticResource ShortcutDescStyle}" />
                    </Grid>
                    <Grid Style="{StaticResource ShortcutRowStyle}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="180" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="[ / ]" Style="{StaticResource ShortcutKeyStyle}" />
                        <TextBlock Grid.Column="1" Text="Decrease / increase playback speed" Style="{StaticResource ShortcutDescStyle}" />
                    </Grid>
                    <Grid Style="{StaticResource ShortcutRowStyle}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="180" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="\" Style="{StaticResource ShortcutKeyStyle}" />
                        <TextBlock Grid.Column="1" Text="Reset playback speed to 1.0x" Style="{StaticResource ShortcutDescStyle}" />
                    </Grid>
                    <Grid Style="{StaticResource ShortcutRowStyle}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="180" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="G / H" Style="{StaticResource ShortcutKeyStyle}" />
                        <TextBlock Grid.Column="1" Text="Subtitle 100 ms earlier / later" Style="{StaticResource ShortcutDescStyle}" />
                    </Grid>
                    <Grid Style="{StaticResource ShortcutRowStyle}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="180" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Shift + G / H" Style="{StaticResource ShortcutKeyStyle}" />
                        <TextBlock Grid.Column="1" Text="Subtitle 500 ms earlier / later" Style="{StaticResource ShortcutDescStyle}" />
                    </Grid>
                    <Grid Style="{StaticResource ShortcutRowStyle}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="180" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="F or Enter" Style="{StaticResource ShortcutKeyStyle}" />
                        <TextBlock Grid.Column="1" Text="Toggle fullscreen (covers the taskbar too)" Style="{StaticResource ShortcutDescStyle}" />
                    </Grid>
                    <Grid Style="{StaticResource ShortcutRowStyle}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="180" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Esc" Style="{StaticResource ShortcutKeyStyle}" />
                        <TextBlock Grid.Column="1" Text="Exit fullscreen" Style="{StaticResource ShortcutDescStyle}" />
                    </Grid>
                    <Grid Style="{StaticResource ShortcutRowStyle}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="180" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Double-click video" Style="{StaticResource ShortcutKeyStyle}" />
                        <TextBlock Grid.Column="1" Text="Play / Pause" Style="{StaticResource ShortcutDescStyle}" />
                    </Grid>
                    <Grid Style="{StaticResource ShortcutRowStyle}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="180" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="T" Style="{StaticResource ShortcutKeyStyle}" />
                        <TextBlock Grid.Column="1" Text="Toggle Always on Top" Style="{StaticResource ShortcutDescStyle}" />
                    </Grid>
                    <Grid Style="{StaticResource ShortcutRowStyle}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="180" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Ctrl + O" Style="{StaticResource ShortcutKeyStyle}" />
                        <TextBlock Grid.Column="1" Text="Open media file" Style="{StaticResource ShortcutDescStyle}" />
                    </Grid>
                    <Grid Style="{StaticResource ShortcutRowStyle}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="180" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Right-click" Style="{StaticResource ShortcutKeyStyle}" />
                        <TextBlock Grid.Column="1" Text="Open the context menu" Style="{StaticResource ShortcutDescStyle}" />
                    </Grid>
                </StackPanel>
            </TabItem>

            <TabItem Header="About" Style="{StaticResource SettingsTabItemStyle}">
                <StackPanel>
                    <TextBlock Text="About" Style="{StaticResource SectionHeadingStyle}" />

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <Image Source="pack://application:,,,/Resources/PetPlayer.ico" Width="40" Height="40" VerticalAlignment="Center" />
                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Pet Player" Foreground="{StaticResource TextPrimaryBrush}" FontSize="15" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding AppVersionText}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />
                        </StackPanel>
                    </StackPanel>

                    <TextBlock Text="{Binding AppDescriptionText}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,10" />
                    <TextBlock Text="Powered by LibVLC / VideoLAN." Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" TextWrapping="Wrap" />
                </StackPanel>
            </TabItem>

        </TabControl>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Cancel" Padding="14,6" Margin="0,0,8,0" Click="CancelButton_Click" />
            <Button Content="Save" Padding="14,6" Click="SaveButton_Click" IsDefault="True" />
        </StackPanel>
        </Grid>
    </Grid>
</Window>
